{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "height": 50,
    "spacing": 10,

    "modules-left": [
        "custom/appmenu",
        "sway/workspaces",
        "custom/filemanager",
        "custom/librewolf",
        "custom/calculator"
    ],

    "modules-center": [
        "sway/window"
    ],

    "modules-right": [
        "tray",
        "pulseaudio",
        "clock",
        "custom/exit"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "persistent-workspaces": {
            "1": [], "2": [], "3": [], "4": [], "5": [],
            "6": [], "7": [], "8": [], "9": []
        },
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九"
        }
    },

    "custom/appmenu": {
        "format": "",
        "on-click": "wofi --show drun",
        "tooltip": false
    },

    "custom/filemanager": {
        "format": "",
        "on-click": "thunar",
        "tooltip": false
    },

    "custom/librewolf": {
        "format": "󰈹", 
        "on-click": "librewolf", 
        "tooltip": false
    },

    "custom/calculator": {
        "format": "",
        "on-click": "qalculate-gtk", 
        "tooltip": false
    },

    "sway/window": {
        "format": "{title}",
        "max-length": 50
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/exit": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    }
}